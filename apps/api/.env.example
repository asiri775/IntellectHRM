# Copy to apps/api/.env and fill in. Never commit real secrets.
DATABASE_URL=postgresql://ihrm:ihrm@localhost:5432/ihrm
REDIS_URL=redis://localhost:6379
PORT=3000
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=14
# 32-byte key, base64. Generate with: openssl rand -base64 32   (KEEP SAFE — losing it makes NIC/bank data unreadable)
DATA_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
BLIND_INDEX_KEY=

STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Email: "log" prints to the console; "smtp" sends for real.
MAIL_PROVIDER=log
MAIL_FROM="Intellect Choice HR <no-reply@intellectchoice.co.nz>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: Chrome/Chromium path for PDF payslips, invoices and quotations (HTML fallback otherwise)
CHROMIUM_PATH=
ENABLE_SCHEDULER=true

# Seed
SEED_ADMIN_EMAIL=admin@intellectchoice.co.nz
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=Intellect Choice
SEED_DEMO=false
SEED_DEMO_PASSWORD=
